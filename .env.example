# AI Agents Sandbox - environment variables
#
# Copy this file to ".env" and fill in your API keys:
#   cp .env.example .env
#
# .env is git-ignored and is loaded into the container automatically
# (docker-compose env_file). All keys are optional — set only the ones
# for the agents you intend to use. Each CLI can also authenticate
# interactively inside the container instead of using a key.

# Anthropic (Claude Code / `claude`)
ANTHROPIC_API_KEY=

# OpenAI (Codex CLI / `codex`)
OPENAI_API_KEY=

# Google (Antigravity CLI / `agy`)
GOOGLE_API_KEY=

# Slack 通知 (任意): Slack Incoming Webhook の URL を設定すると、タスク完了・
# 入力待ちを Slack にも通知します(scripts/notify.sh)。未設定なら Slack は無効。
# Webhook の作り方: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
