# Takumi Guard (GMO Flatt Security) - anonymous / blocking-only mode.
# Routes npm installs through a registry proxy that blocks known-malicious
# packages before they execute. Anonymous mode needs no account/token;
# download tracking and breach notifications are not available in this mode.
# Docs: https://shisho.dev/docs/ja/t/guard/quickstart/npm/
registry=https://npm.flatt.tech/

# Quarantine window: refuse package versions published less than 3 days ago,
# giving time for malicious releases to be detected and pulled. Requires
# npm >= 11.10.0 (the pinned base image ships 11.16.0). Bypass a specific
# version when needed with:  npm i --min-release-age 0 <pkg>@<version>
min-release-age=3
