{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(/etc/shadow)",
      "Read(/etc/passwd)",
      "Edit(/etc/*)",
      "Write(**/.env*)",
      "Edit(**/.env*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(:(){ :|:& };:)",
      "Bash(chmod -R 777 /)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | sudo bash)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | sudo bash)",
      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ]
  },
  "effortLevel": "high"
}
