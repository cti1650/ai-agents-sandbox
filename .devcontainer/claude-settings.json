{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(/etc/shadow)",
      "Read(/etc/passwd)",
      "Edit(/etc/*)",
      "Write(**/.env*)",
      "Edit(**/.env*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(:(){ :|:& };:)",
      "Bash(chmod -R 777 /)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | sudo bash)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | sudo bash)",
      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ]
  },
  "enabledPlugins": {
    "dev-workflow-skills@dev-workflow-marketplace": true,
    "dev-security-skills@dev-workflow-marketplace": true,
    "cosense-cli@cosense-cli": true
  },
  "extraKnownMarketplaces": {
    "dev-workflow-marketplace": {
      "source": {
        "source": "github",
        "repo": "cti1650/dev-workflow-skills"
      }
    },
    "cosense-cli": {
      "source": {
        "source": "github",
        "repo": "helpfeel/cosense-cli"
      }
    }
  },
  "effortLevel": "high",

  "//notify": "タスク完了・入力待ち/質問時に気づけるようターミナルベルで通知する。preferredNotifChannel が入力待ち等のOS通知をベル化し、Stop フックがターミナルへ直接BELを送る(best-effort)。実際に音を鳴らすにはホスト側 VS Code の Terminal Bell (accessibility.signals.terminalBell / terminal.integrated.enableBell) を有効化すること。",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' > /dev/tty 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' > /dev/tty 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
