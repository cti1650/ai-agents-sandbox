{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(/etc/shadow)",
      "Read(/etc/passwd)",
      "Edit(/etc/*)",
      "Write(**/.env*)",
      "Edit(**/.env*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(:(){ :|:& };:)",
      "Bash(chmod -R 777 /)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | sudo bash)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | sudo bash)",
      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ]
  },
  "enabledPlugins": {
    "dev-workflow-skills@dev-workflow-marketplace": true,
    "dev-security-skills@dev-workflow-marketplace": true,
    "cosense-cli@cosense-cli": true
  },
  "extraKnownMarketplaces": {
    "dev-workflow-marketplace": {
      "source": {
        "source": "github",
        "repo": "cti1650/dev-workflow-skills"
      }
    },
    "cosense-cli": {
      "source": {
        "source": "github",
        "repo": "helpfeel/cosense-cli"
      }
    }
  },
  "effortLevel": "high",

  "//notify": "タスク完了(Stop)・入力待ち/質問(Notification)を scripts/notify.sh で通知する。ローカルはターミナルベル + VS Code タブの OSC 9;4 進捗インジケータ(音設定に依存せず視覚で気づける)。環境変数 SLACK_WEBHOOK_URL を設定すると Slack にも送る(オプトイン)。UserPromptSubmit でインジケータを消す。音を鳴らすにはホスト VS Code の accessibility.signals.terminalBell を {sound:on} に(User設定)。preferredNotifChannel は入力待ち等の組み込み通知をベル化する保険。",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"$REPO_ROOT/scripts/notify.sh\" stop" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "bash \"$REPO_ROOT/scripts/notify.sh\" input" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"$REPO_ROOT/scripts/notify.sh\" clear" } ] }
    ]
  }
}
