{
  "$schema": "https://antigravity.google/schemas/settings.json",
  "enableTerminalSandbox": false,
  "toolPermission": "always-proceed",
  "permissions": {
    "allow": [
      "command(git)",
      "command(npm)",
      "command(npx)",
      "command(pnpm)",
      "command(node)",
      "command(python)",
      "command(python3)",
      "command(pip)",
      "command(pip3)",
      "command(gh)",
      "command(jq)",
      "command(cat)",
      "command(ls)",
      "command(mkdir)",
      "command(cp)",
      "command(mv)",
      "command(touch)",
      "command(echo)",
      "command(grep)",
      "command(find)",
      "command(sed)",
      "command(awk)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(sort)",
      "command(uniq)",
      "command(diff)",
      "command(curl)",
      "command(wget)",
      "command(tar)",
      "command(unzip)",
      "command(gzip)",
      "command(tmux)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf ~)",
      "command(rm -rf /*)",
      "command(sudo)",
      "command(chmod -R 777 /)",
      "command(chmod 777 *)",
      "command(curl * | bash)",
      "command(curl * | sh)",
      "command(curl * | sudo bash)",
      "command(wget * | bash)",
      "command(wget * | sh)",
      "command(wget * | sudo bash)",
      "command(npm publish)",
      "command(pnpm publish)",
      "command(git push --force)",
      "command(git push -f)",
      "command(git reset --hard)",
      "command(git clean -fd)",
      "read(**/.env)",
      "read(**/.env.local)",
      "read(**/.env.*.local)",
      "read(**/secrets/**)",
      "read(**/*credentials*)",
      "read(**/*.pem)",
      "read(**/*.key)",
      "read(**/id_rsa*)",
      "read(/etc/shadow)",
      "read(/etc/passwd)",
      "write(**/.env*)",
      "edit(**/.env*)",
      "edit(/etc/*)"
    ]
  }
}
