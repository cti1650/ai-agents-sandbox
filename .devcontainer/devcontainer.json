{
  "name": "AI Agents Sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "ai-sandbox",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/workspace",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-ja",
        "ms-azuretools.vscode-docker",
        "github.copilot",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "locale": "ja"
      }
    }
  },

  "remoteUser": "vscode",

  "postCreateCommand": "cd .. && mkdir -p workspace && npm install && bash scripts/verify.sh",

  "forwardPorts": [],

  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "REPO_ROOT": "/workspaces/${localWorkspaceFolderBasename}",
    "PIP_CONFIG_FILE": "/workspaces/${localWorkspaceFolderBasename}/pip.conf"
  }
}
