#!/bin/bash
# Global pre-commit hook for secret scanning
# This hook runs multiple scanners (secretlint, gitleaks) on staged files
# to prevent committing secrets
#
# If the repo has lefthook configured, delegate to lefthook instead.
# This allows repos with their own hooks (like ai-agents-sandbox) to use lefthook,
# while repos without hooks (like projects in workspace/) still get secretlint protection.

set -e

# Check if this repo has lefthook configured
if [ -f "lefthook.yml" ] || [ -f ".lefthook.yml" ]; then
  # Delegate to lefthook if available
  if command -v lefthook &> /dev/null; then
    exec lefthook run pre-commit
  fi
fi

# No lefthook - run secret scanners directly
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

EXIT_CODE=0

# Run secretlint if available
if command -v secretlint &> /dev/null; then
  echo "Running secretlint on staged files..."
  if ! echo "$STAGED_FILES" | xargs secretlint; then
    EXIT_CODE=1
  fi
elif command -v npx &> /dev/null; then
  if [ -f ".secretlintrc.json" ] || [ -f ".secretlintrc" ] || [ -f ".secretlintrc.js" ]; then
    echo "Running secretlint via npx on staged files..."
    if ! echo "$STAGED_FILES" | xargs npx secretlint; then
      EXIT_CODE=1
    fi
  fi
fi

# Run gitleaks if available (scans staged changes only)
if command -v gitleaks &> /dev/null; then
  echo "Running gitleaks on staged changes..."
  if ! gitleaks protect --staged --no-banner; then
    EXIT_CODE=1
  fi
fi

exit $EXIT_CODE
