#!/bin/bash
# Global pre-commit hook for secretlint
# This hook runs secretlint on staged files to prevent committing secrets

# Get the list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check if secretlint is available (globally or via npx)
if command -v secretlint &> /dev/null; then
  echo "Running secretlint on staged files..."
  echo "$STAGED_FILES" | xargs secretlint
  exit $?
elif command -v npx &> /dev/null; then
  # Try to run via npx if secretlint config exists in repo
  if [ -f ".secretlintrc.json" ] || [ -f ".secretlintrc" ] || [ -f ".secretlintrc.js" ]; then
    echo "Running secretlint via npx on staged files..."
    echo "$STAGED_FILES" | xargs npx secretlint
    exit $?
  fi
fi

# secretlint not available, skip silently
exit 0
