#!/bin/bash
# Global pre-commit hook for secretlint
# This hook runs secretlint on staged files to prevent committing secrets
#
# If the repo has lefthook configured, delegate to lefthook instead.
# This allows repos with their own hooks (like ai-agents-sandbox) to use lefthook,
# while repos without hooks (like projects in workspace/) still get secretlint protection.

# Check if this repo has lefthook configured
if [ -f "lefthook.yml" ] || [ -f ".lefthook.yml" ]; then
  # Delegate to lefthook if available
  if command -v lefthook &> /dev/null; then
    exec lefthook run pre-commit
  fi
fi

# No lefthook - run secretlint directly
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check if secretlint is available
if command -v secretlint &> /dev/null; then
  echo "Running secretlint on staged files..."
  echo "$STAGED_FILES" | xargs secretlint
  exit $?
elif command -v npx &> /dev/null; then
  # Try to run via npx if secretlint config exists in repo
  if [ -f ".secretlintrc.json" ] || [ -f ".secretlintrc" ] || [ -f ".secretlintrc.js" ]; then
    echo "Running secretlint via npx on staged files..."
    echo "$STAGED_FILES" | xargs npx secretlint
    exit $?
  fi
fi

# secretlint not available, skip silently
exit 0
